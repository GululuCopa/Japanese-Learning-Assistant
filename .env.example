# Copy to a local .env only if a development helper needs it.
# AI keys are stored in Electron userData via OS encryption. Never commit real keys.

# Developer-only local Kokoro overrides (absolute paths only; never used from the renderer)
# JLA_KOKORO_BIN=/absolute/path/to/kokoro-launcher
# JLA_KOKORO_ARGS=["--flag"]
# JLA_KOKORO_RUNTIME=/absolute/path/to/kokoro-runtime
# JLA_KOKORO_PORT=8880
